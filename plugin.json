{
  "id": "com.sh1rotr1.powerpulse",
  "name": "PowerPulse 设备电量",
  "version": "0.2.0",
  "description": "读取本机电池、Razer 2.4G 无线外设与蓝牙设备的电量；标题栏面板、设置页与播放栏按钮同步显示设备电量。",
  "author": "sh1rotr1",
  "license": "MIT",
  "type": ["tool", "ui"],
  "main": "index.mjs",
  "engines": { "twilightEcho": ">=1.4.0-perview" },
  "apiVersion": 4,
  "permissions": ["settings", "ui:inject", "network"],
  "repository": "https://github.com/Sh1rotr1/twilight-echo-powerpulse",
  "contributes": {
    "experiences": [
      {
        "id": "powerpulse-panel",
        "name": "设备电量",
        "entry": "ui/panel.html",
        "bridgeVersion": 2,
        "launch": "panel"
      }
    ]
  }
}

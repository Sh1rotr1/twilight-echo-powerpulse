{
  "plugin": {
    "id": "com.sh1rotr1.powerpulse",
    "version": "0.2.0",
    "apiVersion": 4
  },
  "host": {
    "tested": ["1.4.0-perview"],
    "requestedRange": ">=1.4.0-perview",
    "platform": "win32"
  },
  "permissions": ["settings", "ui:inject", "network"],
  "surfaces": {
    "sidebarWidget": {
      "id": "te-powerpulse-sidebar",
      "hostPatch": true,
      "files": [
        "out/renderer/index.html",
        "out/renderer/assets/index-*.js",
        "out/renderer/powerpulse-sidebar.js"
      ],
      "anchor": ".side-menu > #te-powerpulse-sidebar (before .menu-bottom)",
      "bridge": "window.__teExecuteCoreExtension"
    },
    "titleBarButton": {
      "id": "powerpulse-titlebar",
      "title": "设备电量",
      "opens": "experience:powerpulse-panel"
    },
    "experiencePanel": {
      "id": "powerpulse-panel",
      "entry": "ui/panel.html",
      "bridgeVersion": 2,
      "launch": "panel"
    },
    "settingsPanel": {
      "id": "powerpulse-settings",
      "command": "powerpulse.overview"
    },
    "playerBarButton": {
      "id": "powerpulse-bar",
      "command": "powerpulse.toast"
    }
  },
  "notAvailableInHost": ["desktopLyricsWidget", "miniPlayerWidget"],
  "dataSources": [
    {
      "id": "system-battery",
      "api": "Win32_Battery + root\\wmi BatteryStatus",
      "verified": true
    },
    {
      "id": "bluetooth-battery",
      "api": "SetupAPI / DEVPKEY_Bluetooth_Battery {104EA319-6EE2-4701-BD47-8DDBF425BBE5} 2",
      "verified": "reader runs in ~7 ms"
    },
    {
      "id": "razer-wireless-battery",
      "api": "HID feature report 91 bytes, class 0x07 id 0x80 / 0x84",
      "verified": "Razer Viper V4 Pro (1532:00E6) returns level and charging state"
    }
  ],
  "notes": [
    "1.4.0 has no inline sidebar widget extension point; sidebarPage/localSidebarItem are navigation entries, titleBarButton opens a panel.",
    "The host patch exposes the renderer's executeCoreExtension as window.__teExecuteCoreExtension so the injected card reuses the app's own Core connection.",
    "The host patch does not create a second Core connection and does not use the removed window.api.extensions.executeCommand IPC.",
    "App updates replace app.asar and require rerunning host/install-sidebar.mjs.",
    "The experience bridge maps plugin.request to the network permission.",
    "host/ is excluded from the .tep."
  ],
  "checkedAt": "2026-10-26"
}
